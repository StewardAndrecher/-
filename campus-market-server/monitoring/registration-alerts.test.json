          "eval_time": "100s",
          "alertname": "CampusRegistrationProtectionUnavailable",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "campus-market",
                "instance": "fixture:8080",
                "severity": "warning",
                "component": "registration"
              },
              "exp_annotations": {
                "summary": "注册保护出现拒绝服务故障",
                "description": "注册保护开启时，近5分钟出现无法完成保护判断的请求，且条件持续30秒。检查专用Redis连接、计数器和保护日志；最后一次故障离开5分钟窗口后恢复。零错误不代表Redis已通过健康探测。"
              }
            }
          ]
        }
      ]
