        {
          "series": "up{job=\"campus-market\",instance=\"fixture:8080\"}",
          "values": "1+0x90"
        },
        {
          "series": "campus_registration_protection_enabled{job=\"campus-market\",instance=\"fixture:8080\"}",
          "values": "1+0x90"
        },
        {
          "series": "campus_registration_protection_limit{job=\"campus-market\",instance=\"fixture:8080\"}",
          "values": "60+0x90"
        },
        {
          "series": "campus_registration_protection_window_seconds{job=\"campus-market\",instance=\"fixture:8080\"}",
          "values": "60+0x90"
        },
        {
          "series": "campus_registration_decisions_total{job=\"campus-market\",instance=\"fixture:8080\",outcome=\"allowed\"}",
          "values": "0+0x90"
        },
        {
          "series": "campus_registration_decisions_total{job=\"campus-market\",instance=\"fixture:8080\",outcome=\"limited\"}",
          "values": "0+0x90"
        },
        {
          "series": "campus_registration_decisions_total{job=\"campus-market\",instance=\"fixture:8080\",outcome=\"unavailable\"}",
          "values": "0+0x90"
        },
        {
          "series": "campus_registration_decisions_total{job=\"campus-market\",instance=\"fixture:8080\",outcome=\"disabled\"}",
          "values": "0+0x90"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "100s",
          "alertname": "CampusRegistrationMetricsMissing",
          "exp_alerts": []
        },
        {
          "eval_time": "100s",
          "alertname": "CampusRegistrationProtectionUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "400s",
          "alertname": "CampusRegistrationMetricsMissing",
          "exp_alerts": []
        },
        {
          "eval_time": "400s",
          "alertname": "CampusRegistrationProtectionUnavailable",
          "exp_alerts": []
        }
      ]
    },
