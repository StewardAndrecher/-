# 本机模板：由alerting-local.py替换两个占位符，不在源码保存凭证。
global:
  resolve_timeout: 1m
route:
  receiver: discard
  group_by: [job, instance, component]
  group_wait: 10s
  group_interval: 30s
  repeat_interval: 4h
  routes:
    - matchers: ['job="campus-market"']
      receiver: local-history
receivers:
  - name: discard
  - name: local-history
    webhook_configs:
      - url: "http://127.0.0.1:__RECEIVER_PORT__/webhook"
        send_resolved: true
        max_alerts: 100
        timeout: 5s
        http_config:
          follow_redirects: false
          authorization:
            type: Bearer
            credentials_file: __TOKEN_PATH_JSON__
inhibit_rules:
  - source_matchers: ['alertname="CampusBackendScrapeDown"']
    target_matchers: ['component=~"mq|outbox|notification|registration"']
    equal: [job, instance]
